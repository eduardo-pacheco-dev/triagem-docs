generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model QueueEntry {
  id              String    @id @default(uuid()) @db.Uuid
  protocol        String    @unique
  fullName        String    @map("full_name")
  identifier      String
  siteId          String    @map("site_id")
  technicianName  String    @map("technician_name")
  requestType     String    @map("request_type")
  status          String    @default("waiting")
  positionSeq     BigInt    @default(autoincrement()) @map("position_seq")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")

  @@index([siteId], name: "queue_entries_site_id_idx")
  @@map("queue_entries")
}

model RequestType {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("request_types")
}

model SlaConfig {
  id                Int      @id @default(autoincrement())
  expectedWaitMin   Int      @default(60) @map("expected_wait_min")
  expectedServiceMin Int     @default(120) @map("expected_service_min")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("sla_config")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("users")
}
