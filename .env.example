# Prisma — session-mode pooler (runtime queries, IPv4)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-1-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Prisma — transaction-mode pooler (migrations, DDL)
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-1-YOUR_REGION.pooler.supabase.com:5432/postgres"

# Supabase (client-side - prefixo NEXT_PUBLIC_ obrigatório para expor ao browser)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-anon-key"

# NextAuth
AUTH_SECRET="generate-with: npx auth secret"
AUTH_URL="http://localhost:3000"

# Admin credentials armazenados no banco (tabela admins, campo password_hash com bcrypt)
# Para criar/alterar: npm run db:seed (usa valores padrão) ou via Prisma Studio
